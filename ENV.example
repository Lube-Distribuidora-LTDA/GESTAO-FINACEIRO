# Copie para ENV (sem extensão) e preencha. O ENV não vai para o git.
# As mesmas variáveis são cadastradas no projeto da Vercel — quem preenche é o Júlio.

# Supabase — projeto DATA WAREHOUSE (ref ivcnotrynogaljrvvyes)
# 5432 = session pooler. O padrão da casa para serverless é o transaction pooler (6543),
# mas o deste projeto conecta e trava a consulta; medido em 2026-09-25, o 5432 responde
# em menos de 1s e o 6543 estoura. Se um dia o 6543 voltar, é só trocar aqui e na Vercel.
SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.ivcnotrynogaljrvvyes
# a senha vai entre aspas duplas: se tiver # e estiver sem aspas, é cortada pela metade sem avisar
SUPABASE_DB_PASSWORD="..."
